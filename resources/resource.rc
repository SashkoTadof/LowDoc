#include "resource.h"
#include <windows.h>

IDI_APP_ICON ICON "app_icon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "SashkoTadof"
            VALUE "FileDescription",  "LowDoc - Lossless Document Optimizer"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "LowDoc"
            VALUE "LegalCopyright",   "Copyright (C) 2026 SashkoTadof. MIT License."
            VALUE "OriginalFilename", "lowdoc.exe"
            VALUE "ProductName",      "LowDoc"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
